# your settings (may hold your Riot API key) and keys
config.json
.env
.env.*
*.env.txt

# made while running
cache/
history/
logs/

# research agents: their runs, and the playbooks they made on this PC
jobs/
playbooks/
.claude/

# local voice: downloaded by voice/setup-voice.ps1 (the model alone is 310 MB)
voice/.venv/
voice/python/
voice/bin/
voice/models/
voice/samples/
voice/.uv-cache/
__pycache__/
*.wav

# installer build output (attach the exe to a GitHub release instead)
dist/
installer/obj/

# written into the installer only (the commit it was built from)
app/build.json
